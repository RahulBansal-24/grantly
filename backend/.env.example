# GRANTLY — Backend Server Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Provider 1: myScheme (via API Setu - https://apisetu.gov.in/)
# Requires authorized client registration, API Setu client-id & API key
MYSHEME_API_BASE_URL=https://apisetu.gov.in/api/v1/myscheme
MYSHEME_API_KEY=
MYSHEME_CLIENT_ID=

# Provider 2: Open Government Data (OGD) Platform India (https://data.gov.in/)
# Requires API key from data.gov.in developer account and target Resource ID
DATA_GOV_API_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=

# Provider 3: National Scholarship Portal (NSP) - (https://scholarships.gov.in/)
# NSP does not currently offer an unrestricted public API. Authorized state/institutional
# nodal credentials are required. In absence of credentials, fallback to curated verified dataset.
NSP_API_BASE_URL=https://scholarships.gov.in/api/schemes
NSP_API_KEY=

# Provider 4: Buddy4Study (https://www.buddy4study.com/)
# Commercial partner feed integration endpoint. Requires authorized partnership credentials.
BUDDYSTUDY_API_BASE_URL=https://api.buddy4study.com/v1/partner/scholarships
BUDDYSTUDY_API_KEY=

# Provider 5: State Government Portals (MahaDBT / Karnataka SSP / West Bengal SVMCM)
STATE_SCHEME_API_BASE_URL=https://api.ssp.karnataka.gov.in/v1/schemes
STATE_SCHEME_API_KEY=
